# ExifTool config that defines As If's own XMP namespace (XMP-asif).
#
# Everything As If writes about *itself* lives here, so it can always be told
# apart from your own metadata and removed cleanly (`asif undo`, M6).
#
# The namespace URI is provisional until 1.0: changing it later orphans tags
# written before. ".invalid" is reserved (RFC 2606), so it can never resolve
# or be registered by anyone.

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        asif => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::asif' },
        },
    },
);

%Image::ExifTool::UserDefined::asif = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-asif', 2 => 'Image' },
    NAMESPACE => { 'asif' => 'http://ns.as-if.invalid/1.0/' },
    WRITABLE  => 'string',
    ToolVersion            => { },
    ModelId                => { },
    ModelSHA256            => { },
    PromptVersion          => { },
    RunId                  => { },
    Timestamp              => { Writable => 'date', Groups => { 2 => 'Time' } },
    CaptionDigest          => { },  # SHA-256 of the caption As If wrote
    CaptionLang            => { },  # language tag of that caption
    AddedKeywords          => { List => 'Bag' },  # XMP-dc:Subject values As If added
    AddedIPTCKeywords      => { List => 'Bag' },  # IPTC:Keywords values As If added
    # Your own IPTC:Keywords, copied into an XMP-dc:Subject As If created, so
    # apps that read XMP first still show them next to As If's.
    CopiedKeywords         => { List => 'Bag' },
    WroteOriginalImageHash => { Writable => 'boolean' },
    # As If created the IPTC record (compat "wide"): undo may remove the
    # charset and version tags exiftool put in it, once nothing else is left.
    CreatedIPTC            => { Writable => 'boolean' },
    SourceSHA256           => { },  # SHA-256 of the original file this copy was made from
);

1;  # end
